@model IEnumerable<SolarConnect.Models.Review>
@{
    ViewData["Title"] = "Reviews - SolarConnect";
}

<div class="dashboard-container">
    <h1><i class="fas fa-star"></i> Reviews</h1>

    @if (!Model.Any())
    {
        <p>No reviews yet.</p>
    }
    else
    {
        <div class="reviews-list">
            @foreach (var r in Model)
            {
                <div class="card" style="margin-bottom:1.5rem;">
                    <h4 style="color:#ff6b00;">@r.Client.User.FirstName @r.Client.User.LastName</h4>
                    <p><strong>Rating:</strong> ⭐ @r.Rating / 5</p>
                    <p><strong>Comment:</strong> @r.Comment</p>
                    <p><em>@r.CreatedAt.ToLocalTime()</em></p>
                </div>
            }
        </div>
    }

    <a asp-action="Dashboard" class="btn btn-secondary mt-3"><i class="fas fa-arrow-left"></i> Back</a>
</div>
