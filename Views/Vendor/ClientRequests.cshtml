@model IEnumerable<SolarConnect.Models.Request>
@{
    ViewData["Title"] = "Client Requests - SolarConnect";
}

<div class="dashboard-container">
    <h1><i class="fas fa-box-open"></i> Client Requests</h1>

    @if (!Model.Any())
    {
        <p>No available client requests at the moment.</p>
    }
    else
    {
        <table class="table table-striped mt-4">
            <thead style="color:#ff6b00;">
                <tr>
                    <th>Client</th>
                    <th>Property Type</th>
                    <th>Roof Area (m²)</th>
                    <th>Monthly Consumption (kWh)</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Client.User.FirstName @r.Client.User.LastName</td>
                        <td>@r.PropertyType</td>
                        <td>@r.RoofArea</td>
                        <td>@r.MonthlyConsumption</td>
                        <td>@r.Status</td>
                        <td>
                            <a asp-action="CreateQuote" asp-route-requestId="@r.Id" class="btn btn-primary">
                                <i class="fas fa-file-invoice"></i> Submit Quote
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Dashboard" class="btn btn-secondary mt-3"><i class="fas fa-arrow-left"></i> Back</a>
</div>
