@model SolarConnect.Models.Vendor

@{
    ViewData["Title"] = "Vendor Dashboard - SolarConnect";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
        margin: 0;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .welcome-section {
        background: white;
        padding: 2.5rem;
        border-radius: 20px;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
        border-left: 6px solid #1976d2;
    }

        .welcome-section h1 {
            color: #1976d2;
            margin: 0 0 0.5rem 0;
            font-size: 2.2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .welcome-section h1 i {
                font-size: 2.5rem;
                color: #1565c0;
            }

        .welcome-section p {
            color: #666;
            margin: 0;
            font-size: 1.1rem;
        }

    .approval-alert {
        background: linear-gradient(135deg, #fff3cd, #ffe8a1);
        border-left: 6px solid #ffc107;
        color: #856404;
        padding: 1.5rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.9;
        }
    }

    .approval-alert i {
        font-size: 2rem;
    }

    .alert-success {
        background-color: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .stat-box {
        background: linear-gradient(135deg, #1976d2, #1565c0);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(25, 118, 210, 0.3);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-box::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            transition: all 0.5s ease;
        }

        .stat-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(25, 118, 210, 0.4);
        }

            .stat-box:hover::before {
                top: -60%;
                right: -60%;
            }

        .stat-box i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }

        .stat-box h2 {
            font-size: 3.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
            position: relative;
            z-index: 1;
        }

        .stat-box p {
            font-size: 1.1rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }

        .stat-box.orange {
            background: linear-gradient(135deg, #ff8c00, #ffa500);
            box-shadow: 0 4px 15px rgba(255, 140, 0, 0.3);
        }

            .stat-box.orange:hover {
                box-shadow: 0 8px 25px rgba(255, 140, 0, 0.4);
            }

        .stat-box.green {
            background: linear-gradient(135deg, #28a745, #20c997);
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }

            .stat-box.green:hover {
                box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
            }

        .stat-box.purple {
            background: linear-gradient(135deg, #6f42c1, #5a32a3);
            box-shadow: 0 4px 15px rgba(111, 66, 193, 0.3);
        }

            .stat-box.purple:hover {
                box-shadow: 0 8px 25px rgba(111, 66, 193, 0.4);
            }

    h2 {
        color: #1976d2;
        margin-bottom: 1.5rem;
        font-size: 1.8rem;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
    }

    .card {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        border: 2px solid #e0e0e0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px rgba(25, 118, 210, 0.3);
            border-color: #1976d2;
        }

        .card i {
            font-size: 3.5rem;
            color: #1976d2;
            margin-bottom: 1rem;
        }

        .card h3 {
            color: #1565c0;
            margin-bottom: 0.5rem;
            font-size: 1.4rem;
        }

        .card p {
            color: #666;
            font-size: 0.95rem;
        }

        .card.locked {
            opacity: 0.6;
            cursor: not-allowed;
            background: #f8f9fa;
        }

            .card.locked:hover {
                transform: none;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
                border-color: #e0e0e0;
            }

            .card.locked i {
                color: #999;
            }

    .btn-logout {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-logout:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

    @@media (max-width: 768px) {
        .stats {
            grid-template-columns: 1fr;
        }

        .cards {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-container">
    <div class="welcome-section">
        <h1>
            <i class="fas fa-building"></i>
            Vendor Dashboard
        </h1>
        <p>
            Welcome <strong>@Model.CompanyName</strong>! Manage your solar business here. ⚡
        </p>
    </div>

    @if (!Model.IsApproved)
    {
        <div class="approval-alert">
            <i class="fas fa-clock"></i>
            <div>
                <strong>Account Pending Approval</strong>
                <p style="margin: 0.5rem 0 0 0;">Your vendor account is awaiting admin approval. You'll be notified once approved!</p>
            </div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    <!-- Statistics -->
    <div class="stats">
        <div class="stat-box orange">
            <i class="fas fa-clipboard-list"></i>
            <h2>@ViewBag.AvailableRequests</h2>
            <p>Available Requests</p>
        </div>
        <div class="stat-box">
            <i class="fas fa-file-invoice-dollar"></i>
            <h2>@ViewBag.MyQuotes</h2>
            <p>Submitted Quotes</p>
        </div>
        <div class="stat-box green">
            <i class="fas fa-check-circle"></i>
            <h2>@ViewBag.AcceptedProjects</h2>
            <p>Active Projects</p>
        </div>
        <div class="stat-box purple">
            <i class="fas fa-boxes"></i>
            <h2>@(ViewBag.TotalProducts ?? 0)</h2>
            <p>Products Listed</p>
        </div>
        <div class="stat-box" style="background: linear-gradient(135deg, #ffb400, #ff9800); box-shadow: 0 4px 15px rgba(255, 193, 7, 0.35);">
            <i class="fas fa-star"></i>

            @if (ViewBag.TotalRatings > 0)
            {
                <h2>@ViewBag.AverageRating ⭐</h2>
                <p>@ViewBag.TotalRatings Reviews</p>
            }
            else
            {
                <h2>—</h2>
                <p>No Ratings Yet</p>
            }
        </div>

    </div>

    <h2><i class="fas fa-bolt"></i> Quick Actions</h2>

    <!-- Action Cards -->
    <div class="cards">
        @if (Model.IsApproved)
        {
            <a asp-action="BrowseRequests" class="card-link">
                <div class="card">
                    <i class="fas fa-search"></i>
                    <h3>Browse Requests</h3>
                    <p>View available solar installation requests</p>
                </div>
            </a>

            <a asp-action="MyQuotes" class="card-link">
                <div class="card">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <h3>My Quotes</h3>
                    <p>Track submitted quotes and responses</p>
                </div>
            </a>

            <a asp-action="MyProjects" class="card-link">
                <div class="card">
                    <i class="fas fa-tasks"></i>
                    <h3>My Projects</h3>
                    <p>Manage accepted projects and updates</p>
                </div>
            </a>

            <a asp-action="Products" class="card-link">
                <div class="card">
                    <i class="fas fa-boxes"></i>
                    <h3>My Products</h3>
                    <p>Manage your equipment catalog</p>
                </div>
            </a>
        }
        else
        {
            <div class="card locked">
                <i class="fas fa-lock"></i>
                <h3>Features Locked</h3>
                <p>Available after admin approval</p>
            </div>
        }
    </div>

    <form asp-controller="Auth" asp-action="Logout" method="post">
        <button type="submit" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>