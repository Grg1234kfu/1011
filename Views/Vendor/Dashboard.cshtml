@model SolarConnect.Models.Vendor

@{
    ViewData["Title"] = "Vendor Dashboard - SolarConnect";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        background-color: white;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
    }

    h1 {
        color: #ff6b00;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        h1 i {
            font-size: 2.5rem;
            color: #ff8c00;
        }

    .alert-warning {
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
        color: #856404;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .alert-success {
        background-color: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .welcome {
        color: #666;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .company-info {
        background: linear-gradient(135deg, #fff4d6, #ffe8cc);
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
    }

        .company-info h3 {
            color: #ff6b00;
            margin-bottom: 1rem;
        }

        .company-info p {
            color: #666;
            margin: 0.5rem 0;
        }

        .company-info i {
            color: #ff8c00;
            margin-right: 0.5rem;
            width: 20px;
        }

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-box {
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
    }

        .stat-box i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .stat-box h2 {
            font-size: 2rem;
            margin-bottom: 0.3rem;
        }

        .stat-box p {
            font-size: 0.9rem;
            opacity: 0.9;
        }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .card {
        background: linear-gradient(135deg, #fff4d6, #ffe8cc);
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

        .card:hover {
            transform: translateY(-5px);
        }

        .card i {
            font-size: 3rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

        .card h3 {
            color: #ff6b00;
            margin-bottom: 0.5rem;
        }

        .card p {
            color: #666;
            font-size: 0.9rem;
        }

    .btn-logout {
        background: linear-gradient(135deg, #ff6b00, #ff8c00);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 2rem;
    }

        .btn-logout:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(255, 140, 0, 0.3);
        }
</style>

<div class="dashboard-container">
    <h1>
        <i class="fas fa-briefcase"></i>
        Vendor Dashboard
    </h1>

    @if (Model == null)
    {
        <div class="alert-warning">
            <i class="fas fa-exclamation-circle"></i> No vendor data found. Please log in again.
        </div>
    }
    else
    {
        if (!Model.IsApproved)
        {
            <div class="alert-warning">
                <i class="fas fa-clock"></i> <strong>Account Pending:</strong> Your vendor account is awaiting admin approval. You'll be able to access all features once approved.
            </div>
        }
        else
        {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i> <strong>Account Approved!</strong> You can now access all vendor features.
            </div>
        }

        <p class="welcome">
            Welcome, <strong>@Model.User?.FirstName @Model.User?.LastName</strong>!
        </p>

        <div class="company-info">
            <h3><i class="fas fa-building"></i> @(Model.CompanyName ?? "Unnamed Company")</h3>
            <p><i class="fas fa-map-marker-alt"></i> Service Area: @(Model.ServiceArea ?? "Not specified")</p>
            <p><i class="fas fa-calendar"></i> Experience: @Model.YearsOfExperience years</p>

            @if (Model.Rating > 0)
            {
                <p><i class="fas fa-star"></i> Rating: @Model.Rating / 5.0</p>
            }
        </div>

        @if (Model.IsApproved)
        {
            <div class="stats">
                <div class="stat-box">
                    <i class="fas fa-inbox"></i>
                    <h2>@ViewBag.AvailableRequests</h2>
                    <p>Available Requests</p>
                </div>
                <div class="stat-box">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <h2>@ViewBag.MyQuotes</h2>
                    <p>My Quotes</p>
                </div>
                <div class="stat-box">
                    <i class="fas fa-check-circle"></i>
                    <h2>@ViewBag.AcceptedProjects</h2>
                    <p>Accepted Projects</p>
                </div>
                <div class="stat-box">
                    <i class="fas fa-solar-panel"></i>
                    <h2>@ViewBag.MyProjects</h2>
                    <p>My Projects</p>
                </div>
            </div>

            <h2 style="color: #ff6b00; margin-bottom: 1.5rem;">Quick Actions</h2>

            <div class="cards">
                <a asp-action="ClientRequests" class="card">
                    <i class="fas fa-inbox"></i>
                    <h3>Client Requests</h3>
                    <p>Browse solar installation requests</p>
                </a>

                <a asp-action="MyQuotes" class="card">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <h3>My Quotes</h3>
                    <p>Manage submitted quotes</p>
                </a>

                <a asp-action="Products" class="card">
                    <i class="fas fa-box"></i>
                    <h3>Products</h3>
                    <p>Manage solar products catalog</p>
                </a>

                <a asp-controller="Project" asp-action="Index" class="card">
                    <i class="fas fa-solar-panel"></i>
                    <h3>My Projects</h3>
                    <p>Manage installation progress and update clients</p>
                </a>

                <a asp-action="Reviews" class="card">
                    <i class="fas fa-star"></i>
                    <h3>Reviews</h3>
                    <p>View customer feedback</p>
                </a>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 3rem; color: #999;">
                <i class="fas fa-hourglass-half" style="font-size: 4rem; color: #ffc107; margin-bottom: 1rem;"></i>
                <h3 style="color: #666;">Waiting for Approval</h3>
                <p>Your account will be reviewed by an administrator soon. You'll receive access to all features once approved.</p>
            </div>
        }
    }

    <form asp-controller="Auth" asp-action="Logout" method="post">
        <button type="submit" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>
