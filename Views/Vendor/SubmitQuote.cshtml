@model SolarConnect.Models.ViewModels.SubmitQuoteViewModel

@{
    ViewData["Title"] = "Submit Quote - SolarConnect";
    var request = ViewBag.Request as SolarConnect.Models.Request;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
    }

    .form-container {
        max-width: 1000px;
        margin: 0 auto;
        background-color: white;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
    }

    .header-section {
        text-align: center;
        margin-bottom: 2rem;
    }

        .header-section i {
            font-size: 3rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

    h2 {
        color: #ff6b00;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #666;
    }

    .btn-back {
        background: white;
        color: #ff6b00;
        border: 2px solid #ff8c00;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #fff4d6;
        }

    .request-info-box {
        background: linear-gradient(135deg, #d1ecf1, #bee5eb);
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border-left: 4px solid #17a2b8;
    }

        .request-info-box h4 {
            color: #0c5460;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .request-info-box p {
            color: #0c5460;
            margin: 0.5rem 0;
        }

        .request-info-box strong {
            font-weight: 600;
        }

    .form-section {
        margin-bottom: 2.5rem;
    }

        .form-section h3 {
            color: #ff6b00;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #ffe8cc;
        }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-floating {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .form-floating input,
        .form-floating textarea {
            width: 100%;
            padding: 1rem 1rem 0.5rem;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            outline: none;
            background: #fafafa;
            transition: all 0.3s ease;
            font-size: 1rem;
        }

        .form-floating textarea {
            min-height: 120px;
            resize: vertical;
            padding: 1rem;
        }

        .form-floating label {
            position: absolute;
            top: 1rem;
            left: 1rem;
            pointer-events: none;
            transition: 0.2s ease all;
            color: #777;
            background-color: #fff;
            padding: 0 5px;
        }

        .form-floating input:focus + label,
        .form-floating input:not(:placeholder-shown) + label,
        .form-floating textarea:focus + label,
        .form-floating textarea:not(:placeholder-shown) + label {
            top: -0.5rem;
            left: 0.75rem;
            font-size: 0.8rem;
            color: #ff8c00;
        }

        .form-floating input:focus,
        .form-floating textarea:focus {
            border-color: #ff8c00;
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(255, 140, 0, 0.1);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: block;
        color: #dc3545;
    }

    .btn-submit {
        width: 100%;
        padding: 1.2rem;
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-submit:hover {
            background: linear-gradient(135deg, #ff6b00, #ff8c00);
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.3);
        }

    .info-tip {
        background: #fff4d6;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        color: #856404;
        display: flex;
        align-items: start;
        gap: 0.5rem;
    }

        .info-tip i {
            color: #ff8c00;
            margin-top: 0.2rem;
        }
</style>

<div class="form-container">
    <a asp-action="BrowseRequests" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Requests
    </a>

    <div class="header-section">
        <i class="fas fa-file-invoice-dollar"></i>
        <h2>Submit Your Quote</h2>
        <p class="subtitle">Provide your best offer for this solar installation project</p>
    </div>

    @if (request != null)
    {
        <div class="request-info-box">
            <h4><i class="fas fa-info-circle"></i> Client Request Details:</h4>
            <p><strong>Client:</strong> @request.Client.User.FirstName @request.Client.User.LastName</p>
            <p><strong>Location:</strong> @request.PropertyAddress</p>
            <p><strong>Property Type:</strong> @request.PropertyType</p>
            <p><strong>Roof Area:</strong> @request.RoofArea m²</p>
            <p><strong>Monthly Consumption:</strong> @request.MonthlyConsumption kWh</p>
            @if (request.RecommendedSystemSize.HasValue)
            {
                <p><strong>Recommended System:</strong> @request.RecommendedSystemSize.Value.ToString("F2") kW</p>
            }
            @if (!string.IsNullOrEmpty(request.AdditionalNotes))
            {
                <p><strong>Client Notes:</strong> @request.AdditionalNotes</p>
            }
        </div>
    }

    <form asp-action="SubmitQuote" method="post">
        <input type="hidden" asp-for="RequestId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- System Specifications -->
        <div class="form-section">
            <h3><i class="fas fa-solar-panel"></i> System Specifications</h3>

            <div class="form-row">
                <div class="form-floating">
                    <input asp-for="SystemSize" class="form-control" type="number" step="0.01" placeholder="System Size" />
                    <label asp-for="SystemSize">System Size (kW)</label>
                    <span asp-validation-for="SystemSize" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="TotalPrice" class="form-control" type="number" step="0.01" placeholder="Total Price" />
                    <label asp-for="TotalPrice">Total Price (USD)</label>
                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="InstallationCost" class="form-control" type="number" step="0.01" placeholder="Installation Cost" />
                    <label asp-for="InstallationCost">Installation Cost (USD)</label>
                    <span asp-validation-for="InstallationCost" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Equipment Details -->
        <div class="form-section">
            <h3><i class="fas fa-tools"></i> Equipment Details</h3>

            <div class="info-tip">
                <i class="fas fa-lightbulb"></i>
                <p>Specify the brands and models you plan to use. Quality equipment increases trust!</p>
            </div>

            <div class="form-row">
                <div class="form-floating">
                    <input asp-for="PanelBrand" class="form-control" placeholder="Panel Brand" />
                    <label asp-for="PanelBrand">Solar Panel Brand</label>
                    <span asp-validation-for="PanelBrand" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="InverterBrand" class="form-control" placeholder="Inverter Brand" />
                    <label asp-for="InverterBrand">Inverter Brand</label>
                    <span asp-validation-for="InverterBrand" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="BatteryBrand" class="form-control" placeholder="Battery Brand (Optional)" />
                    <label asp-for="BatteryBrand">Battery Brand (Optional)</label>
                    <span asp-validation-for="BatteryBrand" class="text-danger"></span>
                </div>
            </div>

            <div class="form-floating">
                <textarea asp-for="SystemDescription" class="form-control" placeholder="System Description"></textarea>
                <label asp-for="SystemDescription">Detailed System Description</label>
                <span asp-validation-for="SystemDescription" class="text-danger"></span>
            </div>
        </div>

        <!-- Timeline & Warranty -->
        <div class="form-section">
            <h3><i class="fas fa-calendar-check"></i> Timeline & Warranty</h3>

            <div class="form-row">
                <div class="form-floating">
                    <input asp-for="EstimatedInstallationDays" class="form-control" type="number" placeholder="Installation Days" />
                    <label asp-for="EstimatedInstallationDays">Installation Timeline (Days)</label>
                    <span asp-validation-for="EstimatedInstallationDays" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="WarrantyYears" class="form-control" type="number" placeholder="Warranty Years" />
                    <label asp-for="WarrantyYears">Warranty Period (Years)</label>
                    <span asp-validation-for="WarrantyYears" class="text-danger"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-submit">
            <i class="fas fa-paper-plane"></i> Submit Quote to Client
        </button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}