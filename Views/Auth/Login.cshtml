@model SolarConnect.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - SolarConnect";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Full page solar panel background */
        .login-page {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(rgba(0, 40, 80, 0.75), rgba(0, 20, 40, 0.85)), url('https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920') center/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow-y: auto;
        }

        /* Decorative elements */
        .sun-rays {
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            animation: pulse 4s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.6;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.8;
            }
        }

        /* Login Container */
        .login-container {
            max-width: 500px;
            width: 100%;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 255, 255, 0.25);
            padding: 3.5rem 2.5rem;
            border-radius: 25px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            animation: slideInForm 0.8s ease-out;
            position: relative;
            z-index: 10;
        }

        @@keyframes slideInForm {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header Section */
        .header-section {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .logo-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .logo-icon {
            width: 65px;
            height: 65px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            animation: logoFloat 3s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .logo-icon i {
            font-size: 2.2rem;
            color: #FFD700;
        }

        .logo-text {
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }

        .logo-tagline {
            font-size: 0.7rem;
            color: #FFD700;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        h2 {
            color: #fff;
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.5);
        }

        /* Form Group */
        .form-group {
            margin-bottom: 1.5rem;
            position: relative;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.6rem;
                color: #fff;
                font-weight: 600;
                font-size: 0.95rem;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

            .form-group input {
                width: 100%;
                padding: 1.1rem;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-radius: 12px;
                outline: none;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                transition: all 0.3s ease;
                font-size: 0.95rem;
                color: #333;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

                .form-group input::placeholder {
                    color: #999;
                }

                .form-group input:focus {
                    border-color: #FFD700;
                    background-color: #fff;
                    box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.3), 0 4px 15px rgba(0, 0, 0, 0.2);
                    transform: translateY(-2px);
                }

        /* Remember Me */
        .remember-me {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 2rem;
            color: #fff;
            font-size: 0.95rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

            .remember-me input[type="checkbox"] {
                width: 20px;
                height: 20px;
                cursor: pointer;
                accent-color: #FFD700;
            }

            .remember-me label {
                cursor: pointer;
                font-weight: 600;
            }

        /* Alerts */
        .alert {
            padding: 1.2rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
            font-size: 0.95rem;
            font-weight: 600;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 2px solid rgba(220, 53, 69, 0.5);
            color: #FFD700;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            border: 2px solid rgba(40, 167, 69, 0.5);
            color: #fff;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        }

        /* Validation */
        .text-danger {
            font-size: 0.8rem;
            margin-top: 0.4rem;
            display: block;
            color: #FFD700;
            font-weight: 600;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        }

        /* Login Button */
        .btn-login {
            width: 100%;
            padding: 1.2rem;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
            color: #1a1a1a;
            font-weight: 800;
            border: none;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            font-size: 1.1rem;
            cursor: pointer;
            box-shadow: 0 6px 25px rgba(255, 215, 0, 0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.3);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .btn-login:hover::before {
                width: 300px;
                height: 300px;
            }

            .btn-login:hover {
                background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
                transform: translateY(-3px);
                box-shadow: 0 10px 35px rgba(255, 215, 0, 0.6);
            }

            .btn-login:active {
                transform: translateY(-1px);
            }

            .btn-login i {
                margin-right: 0.8rem;
                font-size: 1.2rem;
            }

        /* Divider */
        .divider {
            text-align: center;
            margin: 2rem 0;
            color: rgba(255, 255, 255, 0.6);
            position: relative;
            font-weight: 600;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            font-size: 0.95rem;
        }

            .divider::before,
            .divider::after {
                content: '';
                position: absolute;
                top: 50%;
                width: 40%;
                height: 2px;
                background: rgba(255, 255, 255, 0.2);
            }

            .divider::before {
                left: 0;
            }

            .divider::after {
                right: 0;
            }

        /* Footer */
        .register-link {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 2px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 0.95rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

            .register-link a {
                color: #FFD700;
                font-weight: 800;
                text-decoration: none;
                transition: all 0.3s;
                position: relative;
            }

                .register-link a::after {
                    content: '';
                    position: absolute;
                    bottom: -5px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: #FFD700;
                    transition: width 0.3s;
                }

                .register-link a:hover {
                    color: #FFA500;
                }

                    .register-link a:hover::after {
                        width: 100%;
                    }

        /* Back Button */
        .back-button {
            position: absolute;
            top: 2rem;
            left: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #FFD700;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s;
            z-index: 100;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

            .back-button:hover {
                color: #FFA500;
                transform: translateX(-5px);
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .login-page {
                padding: 1.5rem 1rem;
            }

            .back-button {
                top: 1rem;
                left: 1rem;
                font-size: 0.9rem;
            }

            .login-container {
                padding: 2.5rem 1.8rem;
                max-width: 100%;
            }

            h2 {
                font-size: 1.8rem;
            }

            .logo-text {
                font-size: 1.5rem;
            }

            .logo-icon {
                width: 55px;
                height: 55px;
            }

                .logo-icon i {
                    font-size: 1.8rem;
                }

            .form-group input {
                padding: 1rem;
                font-size: 0.9rem;
            }

            .btn-login {
                padding: 1.1rem;
                font-size: 1rem;
            }
        }

        @@media (max-width: 480px) {
            .login-page {
                padding: 1rem 0.5rem;
            }

            .back-button {
                top: 0.8rem;
                left: 0.8rem;
            }

            .login-container {
                padding: 1.8rem 1.2rem;
                border-radius: 20px;
            }

            h2 {
                font-size: 1.5rem;
            }

            .subtitle {
                font-size: 0.9rem;
            }

            .logo-section {
                margin-bottom: 1rem;
                gap: 0.8rem;
            }

            .form-group label {
                font-size: 0.9rem;
            }

            .form-group input {
                padding: 0.9rem;
                font-size: 0.85rem;
            }

            .remember-me {
                font-size: 0.85rem;
            }

            .btn-login {
                padding: 1rem;
                font-size: 0.95rem;
            }

                .btn-login i {
                    margin-right: 0.4rem;
                    font-size: 1rem;
                }
        }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="sun-rays"></div>

        <a href="/" class="back-button">
            <i class="fas fa-arrow-left"></i> Back to Home
        </a>

        <div class="login-container">
            <div class="header-section">
                <div class="logo-section">
                    <div class="logo-icon">
                        <i class="fas fa-solar-panel"></i>
                    </div>
                    <div>
                        <div class="logo-text">SolarConnect</div>
                        <div class="logo-tagline">Clean Energy</div>
                    </div>
                </div>

                <h2>Welcome Back</h2>
                <p class="subtitle">Login to access your SolarConnect account</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            <form asp-action="Login" asp-controller="Auth" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="your.email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="remember-me">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                    <label asp-for="RememberMe" for="rememberMe">Remember me for 30 days</label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i> Login
                </button>
            </form>

            <div class="divider">OR</div>

            <div class="register-link">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register">Register Here</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>