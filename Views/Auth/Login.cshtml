@model SolarConnect.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - SolarConnect";
}

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* 🌞 Top Navigation Bar */
    .top-nav {
        width: 100%;
        background-color: #fff;
        box-shadow: 0 2px 10px rgba(255, 140, 0, 0.1);
        padding: 0.8rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .top-nav .logo {
            font-weight: 800;
            font-size: 1.4rem;
            color: #ff6b00;
            text-decoration: none;
        }

        .top-nav .nav-links {
            display: flex;
            gap: 1.5rem;
        }

            .top-nav .nav-links a {
                text-decoration: none;
                color: #444;
                font-weight: 500;
                transition: color 0.2s ease;
            }

                .top-nav .nav-links a:hover {
                    color: #ff6b00;
                }

    /* 🌙 Login Form Styles */
    .login-container {
        max-width: 450px;
        width: 100%;
        margin: 4rem auto;
        background-color: #fff;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
        animation: fadeIn 0.6s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .header-section {
        text-align: center;
        margin-bottom: 2rem;
    }

        .header-section i {
            font-size: 3.5rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

    h2 {
        color: #ff6b00;
        font-weight: bold;
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #666;
        font-size: 0.95rem;
    }

    label {
        font-weight: 600;
        color: #444;
        display: block;
        margin-bottom: 0.4rem;
    }

    input {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        background-color: transparent;
        color: #000;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
    }

        input:focus {
            border-color: #ff8c00;
            box-shadow: 0 0 5px rgba(255, 140, 0, 0.2);
            outline: none;
        }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        color: #444;
    }

    .btn-login {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        cursor: pointer;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #ff6b00, #ff8c00);
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.3);
        }

    .divider {
        text-align: center;
        margin: 2rem 0;
        color: #999;
        position: relative;
    }

        .divider::before,
        .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background-color: #e0e0e0;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    .register-link {
        text-align: center;
        margin-top: 1.5rem;
        color: #666;
    }

        .register-link a {
            color: #ff6b00;
            font-weight: 600;
            text-decoration: none;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .alert-danger {
        background-color: #ffe6e6;
        border-left: 4px solid #dc3545;
        color: #721c24;
    }

    .alert-success {
        background-color: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
    }

    @@media (max-width: 600px) {
        .top-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }
</style>


<!-- 🌙 Login Card -->
<div class="login-container">
    <div class="header-section">
        <i class="fas fa-solar-panel"></i>
        <h2>Welcome Back</h2>
        <p class="subtitle">Login to access your SolarConnect account</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Login" asp-controller="Auth" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" placeholder="Email address" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <div class="remember-me">
            <input asp-for="RememberMe" type="checkbox" />
            <label asp-for="RememberMe">Remember Me</label>
        </div>

        <button type="submit" class="btn-login">
            <i class="fas fa-sign-in-alt"></i> Login
        </button>
    </form>

    <div class="divider">OR</div>

    <div class="register-link">
        Don't have an account?
        <a asp-controller="Auth" asp-action="Register">Register Here</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
