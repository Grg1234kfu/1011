@{
    ViewData["Title"] = "Registration - SolarConnect";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Full page solar panel background */
        .registration-page {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(rgba(0, 40, 80, 0.75), rgba(0, 20, 40, 0.85)), url('https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920') center/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow-y: auto;
        }

        .container {
            max-width: 1400px;
            width: 100%;
            margin: auto;
        }

        /* Back to Home Button */
        .back-button {
            position: absolute;
            top: 2rem;
            left: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #FFD700;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s;
            z-index: 100;
        }

            .back-button:hover {
                color: #FFA500;
                transform: translateX(-5px);
            }

        /* Header Section */
        .header-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .logo-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.2rem;
            margin-bottom: 2rem;
        }

        .logo-icon {
            width: 75px;
            height: 75px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            animation: logoFloat 3s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }

        }

        .logo-icon i {
            font-size: 2.8rem;
            color: #FFD700;
        }

        .logo-text {
            font-size: 2.8rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.6);
            letter-spacing: -1px;
        }

        .logo-tagline {
            font-size: 0.8rem;
            color: #FFD700;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: -0.2rem;
        }

        h1 {
            color: #fff;
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.6);
        }

            h1 span {
                background: linear-gradient(135deg, #FFD700, #FFA500);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .subtitle {
            color: rgba(255, 255, 255, 0.95);
            font-size: 1.2rem;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
            margin-bottom: 1.5rem;
        }

        .subtitle-accent {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.8);
            margin-top: 0.5rem;
        }

        /* Cards Grid */
        .choice-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
            margin-bottom: 3rem;
            animation: cardsSlideIn 0.8s ease-out;
        }

        @@keyframes cardsSlideIn {
            from

        {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card-link {
            text-decoration: none;
            color: inherit;
            position: relative;
        }

        .card {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 25px;
            padding: 3rem 2.5rem;
            text-align: center;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .card::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255, 215, 0, 0.15) 0%, transparent 70%);
                opacity: 0;
                transition: opacity 0.5s ease;
            }

            .card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, transparent, #FFD700, transparent);
                opacity: 0;
                transition: opacity 0.5s ease;
            }

            .card:hover::before {
                opacity: 1;
            }

            .card:hover::after {
                opacity: 1;
            }

            .card:hover {
                transform: translateY(-15px);
                border-color: rgba(255, 215, 0, 0.6);
                box-shadow: 0 20px 60px rgba(255, 215, 0, 0.5);
                background: rgba(255, 255, 255, 0.15);
            }

        .card-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            box-shadow: 0 10px 35px rgba(255, 215, 0, 0.5);
            transition: all 0.4s ease;
            position: relative;
        }

            .card-icon::before {
                content: '';
                position: absolute;
                inset: -5px;
                background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
                border-radius: 20px;
                opacity: 0;
                blur: 10px;
                filter: blur(10px);
                transition: opacity 0.4s ease;
                z-index: -1;
            }

        .card:hover .card-icon {
            transform: scale(1.15) rotate(-5deg);
            box-shadow: 0 15px 50px rgba(255, 215, 0, 0.7);
        }

            .card:hover .card-icon::before {
                opacity: 0.5;
            }

        .card-icon i {
            font-size: 3rem;
            color: #fff;
            position: relative;
            z-index: 1;
        }

        .card h2,
        .card h3 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 1.2rem;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }

        .card p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 2rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            flex-grow: 1;
        }

        .card-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(255, 215, 0, 0.25);
            backdrop-filter: blur(15px);
            border: 2px solid rgba(255, 215, 0, 0.5);
            color: #FFD700;
            padding: 0.6rem 1.2rem;
            border-radius: 25px;
            font-size: 0.8rem;
            font-weight: 800;
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.2);
        }

            .card-badge i {
                font-size: 1rem;
            }

        .card-button {
            width: 100%;
            padding: 1.2rem 2rem;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
            color: #1a1a1a;
            font-weight: 800;
            border: none;
            border-radius: 15px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
        }

            .card-button::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.3);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .card-button:hover::before {
                width: 300px;
                height: 300px;
            }

            .card-button:hover {
                background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
                transform: translateY(-4px);
                box-shadow: 0 12px 40px rgba(255, 215, 0, 0.7);
            }

            .card-button:active {
                transform: translateY(-1px);
            }

            .card-button i {
                margin-right: 0.8rem;
                font-size: 1.2rem;
            }

        /* Footer */
        .form-footer {
            text-align: center;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            color: #fff;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            animation: footerFadeIn 0.8s ease-out 0.3s both;
        }

        @@keyframes footerFadeIn {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .form-footer p {
            font-size: 1.1rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

        .form-footer a {
            color: #FFD700;
            font-weight: 800;
            text-decoration: none;
            transition: all 0.3s;
            position: relative;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

            .form-footer a::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: #FFD700;
                transition: width 0.3s;
            }

            .form-footer a:hover {
                color: #FFA500;
            }

                .form-footer a:hover::after {
                    width: 100%;
                }

        /* Decorative elements */
        .sun-rays {
            position: absolute;
            top: -150px;
            right: -150px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            animation: pulse 4s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
            opacity: 0.6;
        }

        50% {
            transform: scale(1.15);
            opacity: 0.9;
        }

        }

        /* Responsive */
        @@media (max-width: 1024px) {
            .choice-cards

        {
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }

        }

        @@media (max-width: 768px) {
            .registration-page

        {
            padding: 1.5rem 1rem;
        }

        .back-button {
            top: 1rem;
            left: 1rem;
            font-size: 0.9rem;
        }

        h1 {
            font-size: 2rem;
        }

        .logo-text {
            font-size: 2rem;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
        }

            .logo-icon i {
                font-size: 2rem;
            }

        .subtitle {
            font-size: 1rem;
        }

        .choice-cards {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .card {
            padding: 2rem 1.5rem;
        }

        .card-icon {
            width: 80px;
            height: 80px;
        }

            .card-icon i {
                font-size: 2.5rem;
            }

        .card h2,
        .card h3 {
            font-size: 1.5rem;
        }

        .card-button {
            padding: 1rem 1.5rem;
            font-size: 1rem;
        }

        }

        @@media (max-width: 480px) {
            .header-section

        {
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 1.6rem;
        }

        .logo-section {
            gap: 0.8rem;
        }

        .card {
            padding: 1.5rem 1.2rem;
        }

        .card-button i {
            margin-right: 0.4rem;
        }

        }
    </style>
</head>
<body>
    <div class="registration-page">
        <div class="sun-rays"></div>

        <a href="/" class="back-button">
            <i class="fas fa-arrow-left"></i> Back to Home
        </a>

        <div class="container">
            <div class="header-section">
                <div class="logo-section">
                    <div class="logo-icon">
                        <i class="fas fa-solar-panel"></i>
                    </div>
                    <div>
                        <div class="logo-text">SolarConnect</div>
                        <div class="logo-tagline">Clean Energy</div>
                    </div>
                </div>

                <h1>Join <span>SolarConnect</span> Lebanon</h1>
                <p class="subtitle">Choose your role and start your solar journey today</p>
                <p class="subtitle-accent">Complete your registration in seconds and access exclusive solar solutions</p>
            </div>

            <div class="choice-cards">
                <a asp-controller="Auth" asp-action="RegisterClient" class="card-link">
                    <div class="card">
                        <div class="card-icon">
                            <i class="fas fa-home"></i>
                        </div>
                        <h2>Homeowner / Business</h2>
                        <p>Get solar quotes, compare vendors, and track your installation project from start to finish with ease.</p>
                        <button type="button" class="card-button">
                            <i class="fas fa-user-plus"></i> Register as Client
                        </button>
                    </div>
                </a>

                <a asp-controller="Auth" asp-action="RegisterVendor" class="card-link">
                    <div class="card">
                        <div class="card-icon">
                            <i class="fas fa-solar-panel"></i>
                        </div>
                        <h2>Solar Vendor / Installer</h2>
                        <p>Grow your business by connecting with customers looking for solar solutions across Lebanon.</p>
                        <button type="button" class="card-button">
                            <i class="fas fa-briefcase"></i> Register as Vendor
                        </button>
                    </div>
                </a>

                
            </div>

            <div class="form-footer">
                <p>
                    Already have an account? <a asp-controller="Auth" asp-action="Login">Log in now</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>