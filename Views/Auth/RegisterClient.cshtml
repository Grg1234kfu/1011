@model SolarConnect.Models.ViewModels.ClientRegisterViewModel

@{
    ViewData["Title"] = "Client Registration - SolarConnect";
}

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
    }

    .form-container {
        max-width: 650px;
        margin: 3rem auto;
        background-color: #fff;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
        animation: fadeInSlide 0.8s ease-out;
    }

    @@keyframes fadeInSlide {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .header-section {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .header-section i {
            font-size: 3rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

    h2 {
        color: #ff6b00;
        margin-bottom: 0.5rem;
        font-weight: bold;
        font-size: 2rem;
    }

    .subtitle {
        color: #666;
        font-size: 0.95rem;
    }

    .section-title {
        color: #ff8c00;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #ffe8cc;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .section-title i {
            font-size: 1.2rem;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    label {
        font-weight: 600;
        color: #444;
        margin-bottom: 0.4rem;
        display: block;
    }

    input, select, textarea {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        color: #000;
        background-color: transparent;
        outline: none;
        transition: all 0.3s ease;
    }

        input:focus, select:focus, textarea:focus {
            border-color: #ff8c00;
            box-shadow: 0 0 5px rgba(255, 140, 0, 0.3);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: block;
        color: #dc3545;
    }

    .btn-animated {
        display: block;
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        cursor: pointer;
    }

        .btn-animated:hover {
            background: linear-gradient(135deg, #ff6b00, #ff8c00);
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.3);
        }

    .form-footer {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e0e0e0;
        font-size: 0.95rem;
        color: #555;
    }

        .form-footer a {
            color: #ff6b00;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s;
        }

            .form-footer a:hover {
                color: #ff8c00;
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .form-container {
            margin: 2rem 1rem;
            padding: 2rem;
        }
    }
</style>

<div class="form-container">
    <div class="header-section">
        <i class="fas fa-solar-panel"></i>
        <h2>Register as Client</h2>
        <p class="subtitle">Join SolarConnect and get personalized solar solutions for your property</p>
    </div>

    <form asp-action="RegisterClient" asp-controller="Auth" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Personal Information Section -->
        <div class="section-title">
            <i class="fas fa-user"></i>
            Personal Information
        </div>

        <div class="form-row">
            <div>
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" placeholder="Enter your first name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" placeholder="Enter your last name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Your phone number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <!-- Security Section -->
        <div class="section-title">
            <i class="fas fa-lock"></i>
            Account Security
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn-animated mt-3">
            <i class="fas fa-user-plus"></i> Create Account
        </button>
    </form>

    <div class="form-footer">
        <p>
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">Login here</a>
        </p>
        <p class="mt-2">
            Are you a solar vendor/installer?
            <a asp-controller="Auth" asp-action="RegisterVendor">Register as Vendor</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
