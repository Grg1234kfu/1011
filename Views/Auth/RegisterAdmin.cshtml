@model SolarConnect.Models.ViewModels.AdminRegisterViewModel

@{
    ViewData["Title"] = "Admin Registration - SolarConnect";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Full page solar panel background */
        .registration-page {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(rgba(0, 40, 80, 0.75), rgba(0, 20, 40, 0.85)), url('https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920') center/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            overflow-y: auto;
        }

        .form-container {
            max-width: 600px;
            width: 100%;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(15px);
            border: 2px solid rgba(255, 255, 255, 0.25);
            padding: 2.5rem 2rem;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            margin: auto;
            animation: fadeInSlide 0.8s ease-out;
        }

        @@keyframes fadeInSlide {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Header Section */
        .header-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .logo-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

            .logo-icon i {
                font-size: 2rem;
                color: #FFD700;
            }

        .logo-text {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
            letter-spacing: -0.5px;
        }

        .logo-tagline {
            font-size: 0.7rem;
            color: #FFD700;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: -0.3rem;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 215, 0, 0.2);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 215, 0, 0.4);
            color: #FFD700;
            padding: 0.5rem 1.2rem;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

            .admin-badge i {
                font-size: 1.1rem;
            }

        h2 {
            color: #fff;
            margin-bottom: 0.5rem;
            font-weight: 700;
            font-size: 1.8rem;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        }

        /* Warning Box */
        .warning-box {
            background: rgba(255, 193, 7, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 193, 7, 0.4);
            border-left: 4px solid #FFC107;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            color: #FFD700;
        }

            .warning-box i {
                margin-right: 0.5rem;
                font-size: 1.1rem;
            }

            .warning-box strong {
                display: block;
                margin-bottom: 0.3rem;
                font-weight: 700;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

            .warning-box p {
                margin: 0;
                font-size: 0.9rem;
                color: rgba(255, 255, 255, 0.9);
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

        /* Form Rows */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 0;
        }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.5rem;
                color: #fff;
                font-weight: 600;
                font-size: 0.9rem;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

            .form-group input,
            .form-group .form-control {
                width: 100%;
                padding: 0.95rem 1.1rem;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-radius: 10px;
                outline: none;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                transition: all 0.3s ease;
                font-size: 0.95rem;
                color: #333;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

                .form-group input:focus,
                .form-group .form-control:focus {
                    border-color: #FFD700;
                    background-color: #fff;
                    box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.3), 0 4px 15px rgba(0, 0, 0, 0.2);
                    transform: translateY(-2px);
                }

                .form-group input::placeholder {
                    color: #999;
                    font-size: 0.9rem;
                }

        .text-danger {
            font-size: 0.8rem;
            margin-top: 0.3rem;
            display: block;
            color: #FFD700;
            font-weight: 600;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        }

        .alert {
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 2px solid rgba(220, 53, 69, 0.5);
            color: #FFD700;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        }

        /* Secret Code Box */
        .secret-code-box {
            background: rgba(23, 162, 184, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(23, 162, 184, 0.4);
            border-left: 4px solid #17a2b8;
            padding: 1.2rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
        }

            .secret-code-box i {
                color: #5ddef4;
                font-size: 1.3rem;
                margin-right: 0.5rem;
            }

            .secret-code-box strong {
                color: #5ddef4;
                display: block;
                margin-bottom: 0.4rem;
                font-weight: 700;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

            .secret-code-box p {
                color: rgba(255, 255, 255, 0.9);
                font-size: 0.85rem;
                margin: 0;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

        /* Button */
        .btn-register {
            width: 100%;
            padding: 1.2rem;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
            color: #1a1a1a;
            font-weight: 800;
            border: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 0.5rem;
            box-shadow: 0 6px 25px rgba(255, 215, 0, 0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .btn-register:hover {
                background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
                transform: translateY(-3px);
                box-shadow: 0 10px 35px rgba(255, 215, 0, 0.5);
            }

            .btn-register:active {
                transform: translateY(-1px);
            }

            .btn-register i {
                margin-right: 0.5rem;
            }

        /* Footer */
        .form-footer {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.2rem;
            border-top: 2px solid rgba(255, 255, 255, 0.2);
            font-size: 0.9rem;
            color: #fff;
        }

            .form-footer p {
                margin-bottom: 0.5rem;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

            .form-footer a {
                color: #FFD700;
                font-weight: 700;
                text-decoration: none;
                transition: color 0.3s;
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            }

                .form-footer a:hover {
                    color: #FFA500;
                    text-decoration: underline;
                }

        /* Decorative elements */
        .sun-rays {
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            animation: pulse 4s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
            opacity: 0.5;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.8;
        }

        }

        /* Responsive */
        @@media (max-width: 768px) {
            .registration-page

        {
            padding: 1.5rem 1rem;
        }

        .form-container {
            padding: 2rem 1.5rem;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        h2 {
            font-size: 1.6rem;
        }

        .logo-text {
            font-size: 1.8rem;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
        }

            .logo-icon i {
                font-size: 1.5rem;
            }

        }

        @@media (max-width: 480px) {
            .form-container

        {
            padding: 1.5rem 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="registration-page">
        <div class="sun-rays"></div>

        <div class="form-container">
            <div class="header-section">
                <div class="logo-section">
                    <div class="logo-icon">
                        <i class="fas fa-solar-panel"></i>
                    </div>
                    <div>
                        <div class="logo-text">SolarConnect</div>
                        <div class="logo-tagline">Clean Energy</div>
                    </div>
                </div>

                <div class="admin-badge">
                    <i class="fas fa-user-shield"></i>
                    <span>Administrator</span>
                </div>

                <h2>Admin Registration</h2>
                <p class="subtitle">Create your administrator account for SolarConnect</p>
            </div>

            <div class="warning-box">
                <strong><i class="fas fa-exclamation-triangle"></i> Team Members Only!</strong>
                <p>This registration is restricted to authorized team members. You need the admin secret code to proceed.</p>
            </div>

            <form asp-action="RegisterAdmin" asp-controller="Auth" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FirstName">First Name</label>
                        <input asp-for="FirstName" class="form-control" type="text" placeholder="John" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName">Last Name</label>
                        <input asp-for="LastName" class="form-control" type="text" placeholder="Doe" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="admin@solarconnect.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+961 XX XXX XXX" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="secret-code-box">
                    <strong><i class="fas fa-key"></i> Admin Secret Code Required</strong>
                    <p>Enter the secret code provided by your team leader to verify you're authorized to create an admin account.</p>
                </div>

                <div class="form-group">
                    <label asp-for="SecretCode">Admin Secret Code</label>
                    <input asp-for="SecretCode" class="form-control" type="password" placeholder="Enter secret code" />
                    <span asp-validation-for="SecretCode" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-register">
                    <i class="fas fa-user-shield"></i> Create Admin Account
                </button>
            </form>

            <div class="form-footer">
                <p>
                    Already have an account?
                    <a asp-controller="Auth" asp-action="Login">Login here</a>
                </p>
                <p>
                    Not an admin?
                    <a asp-controller="Auth" asp-action="Register">Regular Registration</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>