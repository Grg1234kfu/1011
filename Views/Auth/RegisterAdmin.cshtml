@model SolarConnect.Models.ViewModels.AdminRegisterViewModel

@{
    ViewData["Title"] = "Admin Registration - SolarConnect";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
    }

    .form-container {
        max-width: 550px;
        margin: 3rem auto;
        background-color: #fff;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
        animation: fadeInSlide 0.8s ease-out;
    }

    @@keyframes fadeInSlide {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .header-section {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .header-section i {
            font-size: 3rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

    h2 {
        color: #ff6b00;
        margin-bottom: 0.5rem;
        font-weight: bold;
        font-size: 2rem;
    }

    .subtitle {
        color: #666;
        font-size: 0.95rem;
    }

    .warning-box {
        background: linear-gradient(135deg, #fff3cd, #ffe8b3);
        border-left: 4px solid #ffc107;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        color: #856404;
    }

        .warning-box i {
            color: #ff8c00;
            margin-right: 0.5rem;
        }

        .warning-box strong {
            display: block;
            margin-bottom: 0.5rem;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .form-floating {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .form-floating input {
            width: 100%;
            padding: 1rem 1rem 0.5rem;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            outline: none;
            background: #fafafa;
            transition: all 0.3s ease;
            font-size: 1rem;
        }

        .form-floating label {
            position: absolute;
            top: 1rem;
            left: 1rem;
            pointer-events: none;
            transition: 0.2s ease all;
            color: #777;
            background-color: #fff;
            padding: 0 5px;
        }

        .form-floating input:focus + label,
        .form-floating input:not(:placeholder-shown) + label {
            top: -0.5rem;
            left: 0.75rem;
            font-size: 0.8rem;
            color: #ff8c00;
        }

        .form-floating input:focus {
            border-color: #ff8c00;
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(255, 140, 0, 0.1);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: block;
        color: #dc3545;
    }

    .secret-code-box {
        background: linear-gradient(135deg, #d1ecf1, #bee5eb);
        border-left: 4px solid #17a2b8;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }

        .secret-code-box i {
            color: #0c5460;
            font-size: 1.5rem;
            margin-right: 0.5rem;
        }

        .secret-code-box strong {
            color: #0c5460;
            display: block;
            margin-bottom: 0.5rem;
        }

        .secret-code-box p {
            color: #0c5460;
            font-size: 0.9rem;
            margin: 0;
        }

    .btn-animated {
        display: block;
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        cursor: pointer;
    }

        .btn-animated:hover {
            background: linear-gradient(135deg, #ff6b00, #ff8c00);
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.3);
        }

    .form-footer {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e0e0e0;
        font-size: 0.95rem;
        color: #555;
    }

        .form-footer a {
            color: #ff6b00;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s;
        }

            .form-footer a:hover {
                color: #ff8c00;
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .form-container {
            margin: 2rem 1rem;
            padding: 2rem;
        }
    }
</style>

<div class="form-container">
    <div class="header-section">
        <i class="fas fa-user-shield"></i>
        <h2>Admin Registration</h2>
        <p class="subtitle">Create your administrator account for SolarConnect</p>
    </div>

    <div class="warning-box">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Team Members Only!</strong>
        This registration is restricted to authorized team members. You need the admin secret code to proceed.
    </div>

    <form asp-action="RegisterAdmin" asp-controller="Auth" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-row">
            <div class="form-floating">
                <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                <label asp-for="FirstName">First Name</label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                <label asp-for="LastName">Last Name</label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-floating">
            <input asp-for="Email" class="form-control" type="email" placeholder="Email" />
            <label asp-for="Email">Email Address</label>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-floating">
            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
            <label asp-for="PhoneNumber">Phone Number</label>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-floating">
                <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="secret-code-box">
            <i class="fas fa-key"></i>
            <strong>Admin Secret Code Required</strong>
            <p>Enter the secret code provided by your team leader to verify you're authorized to create an admin account.</p>
        </div>

        <div class="form-floating">
            <input asp-for="SecretCode" class="form-control" type="password" placeholder="Secret Code" />
            <label asp-for="SecretCode">Admin Secret Code</label>
            <span asp-validation-for="SecretCode" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-animated mt-3">
            <i class="fas fa-user-shield"></i> Create Admin Account
        </button>
    </form>

    <div class="form-footer">
        <p>
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">Login here</a>
        </p>
        <p class="mt-2">
            Not an admin?
            <a asp-controller="Auth" asp-action="Register">Regular Registration</a>
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}