@model SolarConnect.Models.ViewModels.VendorRegisterViewModel

@{
    ViewData["Title"] = "Vendor Registration - SolarConnect";
}

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
    }

    .form-container {
        max-width: 700px;
        margin: 3rem auto;
        background-color: #fff;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
        animation: fadeInSlide 0.8s ease-out;
    }

    @@keyframes fadeInSlide {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .header-section {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .header-section i {
            font-size: 3rem;
            color: #ff6b00;
            margin-bottom: 1rem;
        }

    h2 {
        color: #ff6b00;
        margin-bottom: 0.5rem;
        font-weight: bold;
        font-size: 2rem;
    }

    .subtitle {
        color: #666;
        font-size: 0.95rem;
    }

    .section-title {
        color: #ff8c00;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #ffe8cc;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .section-title i {
            font-size: 1.2rem;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    label {
        font-weight: 600;
        color: #444;
        margin-bottom: 0.4rem;
        display: block;
    }

    input, select, textarea {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        color: #000;
        background-color: transparent;
        outline: none;
        transition: all 0.3s ease;
    }

        input:focus, select:focus, textarea:focus {
            border-color: #ff8c00;
            box-shadow: 0 0 6px rgba(255, 140, 0, 0.2);
        }

    textarea {
        resize: vertical;
        min-height: 100px;
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: block;
        color: #dc3545;
    }

    .info-box {
        background-color: #fff4d6;
        border-left: 4px solid #ff8c00;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        color: #666;
    }

        .info-box i {
            color: #ff8c00;
            margin-right: 0.5rem;
        }

    .btn-animated {
        display: block;
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff6b00, #ff8c00);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        cursor: pointer;
    }

        .btn-animated:hover {
            background: linear-gradient(135deg, #ff5500, #ff6b00);
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(255, 107, 0, 0.3);
        }

    .form-footer {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e0e0e0;
        font-size: 0.95rem;
        color: #555;
    }

        .form-footer a {
            color: #ff6b00;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s;
        }

            .form-footer a:hover {
                color: #ff8c00;
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .form-container {
            margin: 2rem 1rem;
            padding: 2rem;
        }
    }
</style>

<div class="form-container">
    <div class="header-section">
        <i class="fas fa-solar-panel"></i>
        <h2>Register as Solar Vendor</h2>
        <p class="subtitle">Join Lebanon's leading solar marketplace and connect with customers</p>
    </div>

    <form asp-action="RegisterVendor" asp-controller="Auth" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Personal Information -->
        <div class="section-title">
            <i class="fas fa-user"></i> Personal Information
        </div>

        <div class="form-row">
            <div>
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <!-- Company Information -->
        <div class="section-title">
            <i class="fas fa-building"></i> Company Information
        </div>

        <div class="info-box">
            <i class="fas fa-info-circle"></i>
            All vendor accounts require admin approval before you can start receiving requests.
        </div>

        <div>
            <label asp-for="CompanyName"></label>
            <input asp-for="CompanyName" class="form-control" placeholder="Company name" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="BusinessLicense"></label>
                <input asp-for="BusinessLicense" class="form-control" placeholder="License number" />
                <span asp-validation-for="BusinessLicense" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="YearsOfExperience"></label>
                <input asp-for="YearsOfExperience" class="form-control" type="number" min="0" placeholder="Years" />
                <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
            </div>
        </div>

        <div>
            <label asp-for="ServiceArea"></label>
            <input asp-for="ServiceArea" class="form-control" placeholder="e.g. Beirut, Mount Lebanon, Tripoli" />
            <span asp-validation-for="ServiceArea" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Specialization"></label>
                <input asp-for="Specialization" class="form-control" placeholder="Specialization (Optional)" />
                <span asp-validation-for="Specialization" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Website"></label>
                <input asp-for="Website" class="form-control" type="url" placeholder="Website (Optional)" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>
        </div>

        <div>
            <label asp-for="CompanyDescription"></label>
            <textarea asp-for="CompanyDescription" class="form-control" placeholder="Company description (Optional)"></textarea>
            <span asp-validation-for="CompanyDescription" class="text-danger"></span>
        </div>

        <!-- Security Section -->
        <div class="section-title">
            <i class="fas fa-lock"></i> Account Security
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn-animated mt-3">
            <i class="fas fa-briefcase"></i> Register as Vendor
        </button>
    </form>

    <div class="form-footer">
        <p>
            Already have an account?
            <a asp-controller="Auth" asp-action="Login">Login here</a>
        </p>
        <p class="mt-2">
            Looking for solar solutions?
            <a asp-controller="Auth" asp-action="RegisterClient">Register as Client</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
