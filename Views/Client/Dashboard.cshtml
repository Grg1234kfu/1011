@{
    ViewData["Title"] = "Client Dashboard - SolarConnect";
}

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        background-color: white;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
    }

    h1 {
        color: #ff6b00;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        h1 i {
            font-size: 2.5rem;
            color: #ff8c00;
        }

    .welcome {
        color: #666;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .alert-success {
        background-color: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .card {
        background: linear-gradient(135deg, #fff4d6, #ffe8cc);
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

        .card i {
            font-size: 3rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

        .card h3 {
            color: #ff6b00;
            margin-bottom: 0.5rem;
        }

        .card p {
            color: #666;
            font-size: 0.9rem;
        }

    .btn-logout {
        background: linear-gradient(135deg, #ff6b00, #ff8c00);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 2rem;
    }

        .btn-logout:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(255, 140, 0, 0.3);
        }
</style>

<div class="dashboard-container">
    <h1>
        <i class="fas fa-solar-panel"></i>
        Client Dashboard
    </h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    <p class="welcome">
        Welcome, <strong>@User.Identity.Name</strong>! Your solar journey starts here. 🌞
    </p>

    <div class="cards">
        <a asp-action="CreateRequest" style="text-decoration: none; color: inherit;">
            <div class="card">
                <i class="fas fa-plus-circle"></i>
                <h3>New Solar Request</h3>
                <p>Request quotes from solar vendors</p>
            </div>
        </a>

        <a asp-action="MyRequests" style="text-decoration: none; color: inherit;">
            <div class="card">
                <i class="fas fa-file-alt"></i>
                <h3>My Requests</h3>
                <p>View and manage your requests</p>
            </div>
        </a>

        <div class="card">
            <i class="fas fa-clipboard-list"></i>
            <h3>Received Quotes</h3>
            <p>Compare vendor offers</p>
        </div>

        <div class="card">
            <i class="fas fa-tasks"></i>
            <h3>My Projects</h3>
            <p>Track installation progress</p>
        </div>
    </div>

    <form asp-controller="Auth" asp-action="Logout" method="post">
        <button type="submit" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>