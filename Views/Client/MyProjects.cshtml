@model List<SolarConnect.Models.Quote>

@{
    ViewData["Title"] = "My Projects - SolarConnect";
    var activeProjects = Model.Where(q => q.Status == "Accepted").ToList();
    var completedProjects = Model.Where(q => q.Status == "Completed").ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
        margin: 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    h1 {
        color: #ff6b00;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

        h1 i {
            font-size: 2.5rem;
        }

    h2 {
        color: #333;
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 3px solid #ff8c00;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
    }

        h2 i {
            color: #ff8c00;
        }

    .btn-back {
        background: white;
        color: #ff6b00;
        border: 2px solid #ff8c00;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #fff4e6;
            text-decoration: none;
        }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .project-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border-left: 6px solid #28a745;
    }

        .project-card.completed {
            border-left-color: #6c757d;
            opacity: 0.85;
        }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 140, 0, 0.2);
        }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .project-title {
        color: #ff6b00;
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .status-badge.active {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
        }

        .status-badge.completed {
            background: #6c757d;
            color: white;
        }

    .project-info {
        margin-bottom: 1.5rem;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.8rem;
        color: #666;
    }

        .info-row i {
            color: #ff8c00;
            width: 20px;
        }

    .progress-preview {
        background: linear-gradient(135deg, #fff4d6, #ffe8cc);
        padding: 1.5rem;
        border-radius: 12px;
        margin: 1.5rem 0;
    }

        .progress-preview h4 {
            color: #ff6b00;
            margin-bottom: 1rem;
            font-size: 1rem;
        }

    .progress-bar-container {
        background: white;
        height: 30px;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(135deg, #28a745, #20c997);
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-stages {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .stage {
        text-align: center;
        padding: 0.6rem;
        border-radius: 8px;
        background: white;
        font-size: 0.8rem;
        color: #999;
        border: 1px solid #eee;
    }

        .stage.active {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            font-weight: 600;
            border: none;
        }

    .vendor-notes {
        color: #666;
        margin-top: 1rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #28a745;
        font-size: 0.95rem;
    }

        .vendor-notes strong {
            color: #28a745;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

    .equipment-details {
        background: #f8f9fa;
        padding: 1.2rem;
        border-radius: 10px;
        margin-top: 1rem;
    }

        .equipment-details h5 {
            color: #ff6b00;
            margin-bottom: 0.8rem;
            font-size: 1rem;
        }

    .equipment-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.8rem;
    }

    .equipment-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #666;
        font-size: 0.9rem;
    }

        .equipment-item i {
            color: #1976d2;
            width: 16px;
        }

    .no-projects {
        text-align: center;
        padding: 4rem;
        background: white;
        border-radius: 15px;
        color: #999;
    }

        .no-projects i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #ddd;
        }

    .alert {
        padding: 1rem 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="container">
    <a href="javascript:history.back()" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <h1>
        <i class="fas fa-solar-panel"></i>
        My Projects
    </h1>

    <!-- Active Projects Section -->
    <h2>
        <i class="fas fa-hammer"></i>
        Active Projects (@activeProjects.Count)
    </h2>

    @if (activeProjects.Any())
    {
        <div class="projects-grid">
            @foreach (var project in activeProjects)
            {
                <div class="project-card">
                    <div class="project-header">
                        <h3 class="project-title">@project.Request.PropertyType Solar System</h3>
                        <span class="status-badge active">
                            <i class="fas fa-check-circle"></i> In Progress
                        </span>
                    </div>

                    <div class="project-info">
                        <div class="info-row">
                            <i class="fas fa-map-marker-alt"></i>
                            <strong>Location:</strong> @project.Request.PropertyAddress
                        </div>
                        <div class="info-row">
                            <i class="fas fa-building"></i>
                            <strong>Vendor:</strong> @project.Vendor.CompanyName
                        </div>
                        <div class="info-row">
                            <i class="fas fa-phone"></i>
                            <strong>Phone:</strong> @project.Vendor.User.PhoneNumber
                        </div>
                        <div class="info-row">
                            <i class="fas fa-envelope"></i>
                            <strong>Email:</strong> @project.Vendor.User.Email
                        </div>
                        <div class="info-row">
                            <i class="fas fa-bolt"></i>
                            <strong>System Size:</strong> @project.SystemSize kW
                        </div>
                        <div class="info-row">
                            <i class="fas fa-hourglass-end"></i>
                            <strong>Installation Time:</strong> @project.EstimatedInstallationDays days
                        </div>
                        <div class="info-row">
                            <i class="fas fa-shield-alt"></i>
                            <strong>Warranty:</strong> @project.WarrantyYears years
                        </div>
                        <div class="info-row">
                            <i class="fas fa-dollar-sign"></i>
                            <strong>Total Cost:</strong> $@project.TotalPrice.ToString("N2")
                        </div>
                    </div>

                    <!-- PROGRESS SECTION - SHOWS VENDOR UPDATES -->
                    <div class="progress-preview">
                        <h4><i class="fas fa-tasks"></i> Installation Progress</h4>
                        <div class="progress-bar-container">
                            <div class="progress-bar" style="width: @(project.ProgressPercentage)%">
                                @(project.ProgressPercentage)%
                            </div>
                        </div>
                        <p style="color: #666; margin-top: 0.5rem; font-size: 0.9rem;">
                            <strong>Current Status:</strong> @(project.ProjectStatus ?? "Pending Start")
                        </p>
                        @if (project.ProjectStartDate.HasValue)
                        {
                            <p style="color: #666; margin-top: 0.3rem; font-size: 0.9rem;">
                                <i class="fas fa-clock"></i> Started: @project.ProjectStartDate.Value.ToString("MMM dd, yyyy")
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(project.VendorNotes))
                        {
                            <div class="vendor-notes">
                                <strong>
                                    <i class="fas fa-comment"></i> Latest Update from Vendor:
                                </strong>
                                <p style="margin: 0;">@project.VendorNotes</p>
                            </div>
                        }
                    </div>

                    <!-- Equipment Details -->
                    <div class="equipment-details">
                        <h5><i class="fas fa-tools"></i> Equipment Details</h5>
                        <div class="equipment-grid">
                            <div class="equipment-item">
                                <i class="fas fa-solar-panel"></i>
                                <span><strong>Panels:</strong> @project.PanelBrand</span>
                            </div>
                            <div class="equipment-item">
                                <i class="fas fa-microchip"></i>
                                <span><strong>Inverter:</strong> @project.InverterBrand</span>
                            </div>
                            @if (!string.IsNullOrEmpty(project.BatteryBrand))
                            {
                                <div class="equipment-item">
                                    <i class="fas fa-battery-full"></i>
                                    <span><strong>Battery:</strong> @project.BatteryBrand</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-projects">
            <i class="fas fa-clipboard-list"></i>
            <h3>No Active Projects</h3>
            <p>You haven't accepted any quotes yet. Accept a quote to see your project here!</p>
        </div>
    }

    <!-- Completed Projects Section -->
    <h2>
        <i class="fas fa-check-double"></i>
        Completed Projects (@completedProjects.Count)
    </h2>

    @if (completedProjects.Any())
    {
        <div class="projects-grid">
            @foreach (var project in completedProjects)
            {
                <div class="project-card completed">
                    <div class="project-header">
                        <h3 class="project-title">@project.Request.PropertyType Solar System</h3>
                        <span class="status-badge completed">
                            <i class="fas fa-check-circle"></i> Completed
                        </span>
                    </div>

                    <div class="project-info">
                        <div class="info-row">
                            <i class="fas fa-map-marker-alt"></i>
                            <strong>Location:</strong> @project.Request.PropertyAddress
                        </div>
                        <div class="info-row">
                            <i class="fas fa-building"></i>
                            <strong>Vendor:</strong> @project.Vendor.CompanyName
                        </div>
                        <div class="info-row">
                            <i class="fas fa-phone"></i>
                            <strong>Phone:</strong> @project.Vendor.User.PhoneNumber
                        </div>
                        <div class="info-row">
                            <i class="fas fa-calendar-check"></i>
                            <strong>Completed:</strong> @(project.ProjectCompletionDate?.ToString("MMM dd, yyyy") ?? "N/A")
                        </div>
                        <div class="info-row">
                            <i class="fas fa-bolt"></i>
                            <strong>System Size:</strong> @project.SystemSize kW
                        </div>
                        <div class="info-row">
                            <i class="fas fa-dollar-sign"></i>
                            <strong>Total Cost:</strong> $@project.TotalPrice.ToString("N2")
                        </div>
                    </div>

                    <!-- Completion Progress -->
                    <div class="progress-preview">
                        <div class="progress-bar-container">
                            <div class="progress-bar" style="width: 100%">
                                100% Complete ✅
                            </div>
                        </div>
                        @if (project.ProjectStartDate.HasValue && project.ProjectCompletionDate.HasValue)
                        {
                            var duration = (project.ProjectCompletionDate.Value - project.ProjectStartDate.Value).Days;
                            <p style="color: #666; margin-top: 0.8rem; font-size: 0.9rem;">
                                <i class="fas fa-hourglass-end"></i> Duration: @duration days
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(project.VendorNotes))
                        {
                            <div class="vendor-notes">
                                <strong>
                                    <i class="fas fa-comment"></i> Final Notes:
                                </strong>
                                <p style="margin: 0;">@project.VendorNotes</p>
                            </div>
                        }
                    </div>

                    <!-- Equipment Details -->
                    <div class="equipment-details">
                        <h5><i class="fas fa-tools"></i> Installed Equipment</h5>
                        <div class="equipment-grid">
                            <div class="equipment-item">
                                <i class="fas fa-solar-panel"></i>
                                <span><strong>Panels:</strong> @project.PanelBrand</span>
                            </div>
                            <div class="equipment-item">
                                <i class="fas fa-microchip"></i>
                                <span><strong>Inverter:</strong> @project.InverterBrand</span>
                            </div>
                            @if (!string.IsNullOrEmpty(project.BatteryBrand))
                            {
                                <div class="equipment-item">
                                    <i class="fas fa-battery-full"></i>
                                    <span><strong>Battery:</strong> @project.BatteryBrand</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-projects">
            <i class="fas fa-clipboard-check"></i>
            <h3>No Completed Projects Yet</h3>
            <p>Completed projects will appear here once vendors finish the installation.</p>
        </div>
    }
</div>