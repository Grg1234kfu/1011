@model IEnumerable<SolarConnect.Models.Request>

@{
    ViewData["Title"] = "My Requests - SolarConnect";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        padding: 2rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        background-color: white;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(255, 140, 0, 0.15);
    }

    h1 {
        color: #ff6b00;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        h1 i {
            color: #ff8c00;
        }

    .alert-success {
        background-color: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .actions-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .btn {
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff8c00, #ffa500);
        color: white;
    }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(255, 140, 0, 0.3);
        }

    .btn-secondary {
        background: white;
        color: #ff6b00;
        border: 2px solid #ff8c00;
    }

        .btn-secondary:hover {
            background: #fff4d6;
        }

    .request-card {
        background: #fafafa;
        border-left: 4px solid #ff8c00;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .request-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.2);
        }

    .request-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
    }

    .request-title {
        color: #ff6b00;
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .status-badge {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-open {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .status-quoted {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-accepted {
        background-color: #d4edda;
        color: #155724;
    }

    .status-closed {
        background-color: #f8d7da;
        color: #721c24;
    }

    .request-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .detail-item {
        color: #666;
    }

        .detail-item i {
            color: #ff8c00;
            margin-right: 0.5rem;
            width: 20px;
        }

        .detail-item strong {
            color: #333;
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #999;
    }

        .empty-state i {
            font-size: 5rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

    .btn-view {
        background: linear-gradient(135deg, #17a2b8, #138496);
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-right: 0.5rem;
        margin-top: 0.5rem;
    }

        .btn-view:hover {
            transform: scale(1.05);
            color: white;
        }

    /* AI Button Styles */
    .btn-ai-analyze {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        margin-top: 0.5rem;
    }

        .btn-ai-analyze:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
            color: white;
        }

        .btn-ai-analyze i:last-child {
            animation: sparkle 2s infinite;
        }

    @@keyframes sparkle {
        0%, 100%

    {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.6;
        transform: scale(1.2);
    }

    }

    .ai-info-box {
        background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%);
        border-left: 4px solid #667eea;
        padding: 1rem;
        border-radius: 10px;
        margin-top: 1rem;
        display: flex;
        align-items: start;
        gap: 1rem;
    }

        .ai-info-box i {
            font-size: 1.5rem;
            color: #667eea;
            margin-top: 0.2rem;
        }

        .ai-info-box .content {
            flex: 1;
        }

        .ai-info-box h4 {
            color: #667eea;
            margin: 0 0 0.5rem 0;
            font-size: 1rem;
        }

        .ai-info-box p {
            margin: 0;
            color: #5a67d8;
            font-size: 0.9rem;
            line-height: 1.4;
        }

    .quotes-count {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: #fff3cd;
        color: #856404;
        padding: 0.3rem 0.8rem;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }
</style>

<div class="container">
    <div class="actions-bar">
        <h1>
            <i class="fas fa-file-alt"></i>
            My Solar Requests
        </h1>
        <div>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Dashboard
            </a>
            <a asp-action="CreateRequest" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Request
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (Model.Any())
    {
        @foreach (var request in Model)
        {
            var quotesCount = ViewBag.QuotesCounts != null ? ((Dictionary<int, int>)ViewBag.QuotesCounts).GetValueOrDefault(request.Id, 0) : 0;

            <div class="request-card">
                <div class="request-header">
                    <div>
                        <div class="request-title">
                            <i class="fas fa-solar-panel"></i> @request.PropertyType Solar Installation
                            @if (quotesCount > 0)
                            {
                                <span class="quotes-count">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                    @quotesCount Quote@(quotesCount > 1 ? "s" : "")
                                </span>
                            }
                        </div>
                        <p style="color: #999; font-size: 0.9rem; margin: 0;">
                            <i class="far fa-calendar"></i> Requested on @request.CreatedAt.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                    <span class="status-badge status-@request.Status.ToLower()">
                        @request.Status
                    </span>
                </div>

                <div class="request-details">
                    <div class="detail-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <strong>Location:</strong><br />
                        @request.PropertyAddress
                    </div>
                    <div class="detail-item">
                        <i class="fas fa-home"></i>
                        <strong>Type:</strong><br />
                        @request.PropertyType
                    </div>
                    <div class="detail-item">
                        <i class="fas fa-ruler-combined"></i>
                        <strong>Roof Area:</strong><br />
                        @request.RoofArea m²
                    </div>
                    <div class="detail-item">
                        <i class="fas fa-bolt"></i>
                        <strong>Consumption:</strong><br />
                        @request.MonthlyConsumption kWh/month
                    </div>
                    @if (request.RecommendedSystemSize.HasValue)
                    {
                        <div class="detail-item">
                            <i class="fas fa-lightbulb"></i>
                            <strong>Recommended:</strong><br />
                            @request.RecommendedSystemSize.Value.ToString("F2") kW system
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(request.AdditionalNotes))
                {
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
                        <strong style="color: #ff6b00;">Notes:</strong>
                        <p style="color: #666; margin-top: 0.5rem;">@request.AdditionalNotes</p>
                    </div>
                }

                <div style="margin-top: 1.5rem;">
                    <a asp-action="RequestDetails" asp-route-id="@request.Id" class="btn-view">
                        <i class="fas fa-eye"></i> View Details & Quotes
                    </a>

                    @* Show AI Analysis button only if there are 2+ quotes *@
                    @if (quotesCount >= 2)
                    {
                        <a asp-action="AIQuoteAnalysis" asp-controller="Client" asp-route-requestId="@request.Id" class="btn-ai-analyze">
                            <i class="fas fa-robot"></i>
                            <i class="fas fa-sparkles"></i>
                            Get AI Recommendation
                        </a>
                    }
                </div>

                @* Show AI info box if there are multiple quotes *@
                @if (quotesCount >= 2)
                {
                    <div class="ai-info-box">
                        <i class="fas fa-lightbulb"></i>
                        <div class="content">
                            <h4>🤖 Not sure which quote to choose?</h4>
                            <p>Let our AI analyze all @quotesCount quotes and recommend the best option based on price, quality, warranty, and vendor reputation.</p>
                        </div>
                    </div>
                }
                else if (quotesCount == 1)
                {
                    <div class="ai-info-box" style="background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%); border-left-color: #ffc107;">
                        <i class="fas fa-info-circle" style="color: #856404;"></i>
                        <div class="content">
                            <h4 style="color: #856404;">💡 Waiting for more quotes</h4>
                            <p style="color: #856404;">You have 1 quote. AI analysis works best with 2 or more quotes to compare. Wait for more vendors to respond!</p>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h2>No Requests Yet</h2>
            <p>You haven't created any solar installation requests yet.</p>
            <a asp-action="CreateRequest" class="btn btn-primary" style="margin-top: 1rem;">
                <i class="fas fa-plus"></i> Create Your First Request
            </a>
        </div>
    }
</div>