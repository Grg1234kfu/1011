@model IEnumerable<SolarConnect.Models.Request>
@{
    ViewData["Title"] = "My Requests";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="dashboard-container">
    <h1><i class="fas fa-folder-open"></i> My Requests</h1>
    @if (!Model.Any())
    {
        <p>You haven't created any requests yet.</p>
    }
    else
    {
        <table class="table table-striped mt-4">
            <thead style="color:#ff6b00;">
                <tr><th>Address</th><th>Type</th><th>Roof Area</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.PropertyAddress</td>
                        <td>@r.PropertyType</td>
                        <td>@r.RoofArea</td>
                        <td>@r.Status</td>
                        <td>@r.CreatedAt.ToLocalTime()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="actions mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>
