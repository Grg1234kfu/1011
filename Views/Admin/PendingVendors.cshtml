@model IEnumerable<SolarConnect.Models.Vendor>

@{
    ViewData["Title"] = "Pending Vendors - Admin";
}

<style>
    .wrap { max-width: 1200px; margin: 0 auto; padding: 30px; }
    .back { display:inline-block; margin-bottom: 15px; color:#ff6b00; text-decoration:none; font-weight:600; }
    .alert { background: #eaffea; border: 1px solid #a6e3a6; padding: 12px; border-radius: 10px; margin-bottom: 15px; color: #2d7a2d; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow:hidden; }
    th, td { padding: 12px; border-bottom: 1px solid #eee; text-align:left; vertical-align: top; }
    th { background: #fff4d6; color: #ff6b00; }
    .btn { padding: 8px 12px; border-radius: 10px; border: none; cursor: pointer; font-weight: 600; }
    .btn-approve { background: #22c55e; color: white; }
    .btn-reject { background: #ef4444; color: white; margin-left: 8px; }
    .small { color:#666; font-size: 12px; }
</style>

<div class="wrap">
    <a asp-action="Dashboard" class="back">← Back to Dashboard</a>

    <h2>Pending Vendors</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p>No pending vendors right now ✅</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Vendor</th>
                    <th>Company</th>
                    <th>Specialization</th>
                    <th>Service Area</th>
                    <th>Created</th>
                    <th style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>
                        <div><strong>@(v.User != null ? (v.User.FirstName + " " + v.User.LastName) : "Unknown")</strong></div>
                        <div class="small">@v.User?.Email</div>
                        <div class="small">@v.User?.PhoneNumber</div>
                    </td>
                    <td>
                        <div><strong>@v.CompanyName</strong></div>
                        <div class="small">License: @v.BusinessLicense</div>
                        <div class="small">Experience: @v.YearsOfExperience yrs</div>
                    </td>
                    <td>@v.Specialization</td>
                    <td>@v.ServiceArea</td>
                    <td>@v.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form asp-action="ApproveVendor" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Id" />
                            <button type="submit" class="btn btn-approve">Approve</button>
                        </form>

                        <form asp-action="RejectVendor" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Id" />
                            <button type="submit" class="btn btn-reject"
                                    onclick="return confirm('Reject and delete this vendor + user?');">
                                Reject
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
