@model SolarConnect.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<style>
    .wrap { max-width: 700px; margin: 0 auto; padding: 30px; }
    .card { background:#fff; padding:20px; border-radius:12px; }
    .btn { padding:10px 14px; border-radius:10px; font-weight:700; border:1px solid #ff8c00; cursor:pointer; text-decoration:none; display:inline-block; }
    .btn-danger { background:#b00020; color:#fff; border-color:#b00020; }
    .btn-light { background:#fff; color:#ff6b00; }
</style>

<div class="wrap">
    <a asp-action="Users" class="btn btn-light">← Back to Users</a>
    <h2>Delete User</h2>

    <div class="card">
        <p>Are you sure you want to delete this user?</p>
        <ul>
            <li><strong>ID:</strong> @Model.Id</li>
            <li><strong>Name:</strong> @Model.FirstName @Model.LastName</li>
            <li><strong>Email:</strong> @Model.Email</li>
            <li><strong>Role:</strong> @Model.Role</li>
        </ul>

        <form asp-action="DeleteUserConfirmed" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
    </div>
</div>
