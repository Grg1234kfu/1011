@model SolarConnect.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Reports & Analytics - SolarConnect";
}
<div class="dashboard-container">
    <h1><i class="fas fa-chart-bar"></i> Reports & Analytics</h1>

    <p>Quick performance overview:</p>
    <ul style="color:#ff6b00;font-size:1.1rem;">
        <li>Total Clients: <strong>@Model.TotalClients</strong></li>
        <li>Total Vendors: <strong>@Model.TotalVendors</strong></li>
        <li>Pending Approvals: <strong>@Model.PendingApprovals</strong></li>
        <li>Active Requests: <strong>@Model.ActiveRequests</strong></li>
    </ul>

    <p style="color:#666;">Charts and detailed analytics will be added later.</p>

    <div class="actions mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>
