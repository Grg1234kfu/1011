@model SolarConnect.Models.ViewModels.AdminEditUserViewModel

@{
    ViewData["Title"] = "Edit User";
}

<style>
    .wrap { max-width: 700px; margin: 0 auto; padding: 30px; }
    .card { background:#fff; padding:20px; border-radius:12px; }
    .field { margin-bottom: 12px; }
    label { display:block; font-weight:600; margin-bottom:6px; }
    input, select { width:100%; padding:10px; border-radius:10px; border:1px solid #ddd; }
    .btn { padding:10px 14px; border-radius:10px; font-weight:600; border:1px solid #ff8c00; cursor:pointer; }
    .btn-primary { background:#ff8c00; color:#fff; }
    .btn-light { background:#fff; color:#ff6b00; text-decoration:none; display:inline-block; border:1px solid #ff8c00; padding:10px 14px; border-radius:10px; }
    .text-danger { color:#b00020; font-size: 13px; }
</style>

<div class="wrap">
    <a asp-action="Users" class="btn-light">← Back to Users</a>
    <h2>Edit User</h2>

    <div class="card">
        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="field">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" />
                <span class="text-danger" asp-validation-for="FirstName"></span>
            </div>

            <div class="field">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" />
                <span class="text-danger" asp-validation-for="LastName"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>

            <div class="field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" />
                <span class="text-danger" asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="field">
                <label asp-for="Role"></label>
                <select asp-for="Role">
                    <option value="Client">Client</option>
                    <option value="Vendor">Vendor</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div class="field">
                <label asp-for="IsActive"></label>
                <select asp-for="IsActive">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
